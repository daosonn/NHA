{
  "name": "nha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:web": "pnpm --filter mobile web",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:ai": "node scripts/dev-ai.mjs",
    "test:ai": "node scripts/dev-ai.mjs --test",
    "test:e2e": "pnpm --filter api test:e2e",
    "verify": "pnpm build:tokens && pnpm --filter api exec tsc --noEmit -p tsconfig.json && pnpm --filter mobile typecheck && pnpm --filter mobile check:i18n && pnpm test:ai && pnpm test:e2e",
    "studio": "pnpm --filter api exec prisma studio",
    "seed": "pnpm --filter api exec prisma db seed",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "lint:web": "pnpm --filter web lint",
    "lint:api": "pnpm --filter api lint",
    "lint": "pnpm lint:web && pnpm lint:api",
    "build:tokens": "pnpm --filter @nha/tokens build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "apps/mobile/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
