# AI service (FastAPI) — chỉ NestJS gọi vào đây, mobile KHÔNG gọi trực tiếp (CLAUDE.md §3).
# Copy sang .env rồi điền key thật. KHÔNG commit .env.

# Bật mock: mọi endpoint trả dữ liệu giả lập đúng schema, 0 token — core app phải chạy được khi AI tắt.
AI_MOCK=1

OPENAI_API_KEY=
# Model rẻ cho phân tích ảnh / model mạnh cho gợi ý (giống demo onemoretime)
MODEL_ANALYSIS=gpt-5-mini
MODEL_SUGGEST=gpt-5

HOST=127.0.0.1
PORT=8000

# Token nội bộ đơn giản: NestJS gửi header `x-internal-token` khớp giá trị này.
# Để trống = không kiểm tra (dev). Production PHẢI đặt.
INTERNAL_TOKEN=
