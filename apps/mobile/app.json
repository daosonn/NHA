{
  "expo": {
    "name": "NHA",
    "slug": "nha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nha",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FAF9F8",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nha.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-blush.png"
      }
    },
    "android": {
      "package": "com.nha.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F58B7B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-localization", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
