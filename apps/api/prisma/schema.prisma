// Full-MVP schema — implements docs/02-backend/database.md (sprint-0 design,
// 2026-08-14). 25 models. Three constraints live as raw SQL in the migration
// because Prisma cannot express CHECK constraints:
//   - LifeProfile: exactly one of userId/memberId (XOR)
//   - Media: at most one of postId/memoId/lifeEventId (one-parent rule)
//   - Relationship: fromMemberId <> toMemberId

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationshipType {
  PARENT
  SPOUSE
  SIBLING
  ADOPTED_PARENT
  STEP_PARENT
  OTHER
}

enum PostType {
  POST
  EVENT
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
}

enum SpecialDateType {
  BIRTHDAY
  ANNIVERSARY
  MEMORIAL
  TET // Tết Nguyên Đán — mặc định đi với isLunar (2026-09-01, mockup 12c)
  MILESTONE // tốt nghiệp, thôi nôi… — hay dùng với repeatsYearly=false
  CUSTOM // "Other" trên UI — KHÔNG đổi tên: PG không DROP VALUE được
}

enum SpecialDateTheme {
  BUNTING
  CONFETTI_CANDLES
  FLORAL_BORDER
}

enum NotificationType {
  NEW_POST
  COMMENT
  REACTION
  MEMBER_TAG
  FAMILY_INVITE
  BIRTHDAY_REMINDER
  EVENT_REMINDER
  CARE_REMINDER
  AI_SUGGESTION
}

enum VideoJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum EditEntityType {
  LIFE_PROFILE
  LIFE_EVENT
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

// ─── Accounts & auth ────────────────────────────────────────────────────────

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String
  name                 String
  avatarKey            String?
  locale               String?
  notificationSettings Json?
  privacySettings      Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  createdFamilies     Family[]             @relation("FamilyCreator")
  memberships         FamilyMember[]
  lifeProfile         LifeProfile?         @relation("UserProfile")
  editedProfiles      LifeProfile[]        @relation("ProfileLastEditor")
  posts               Post[]
  uploadedMedia       Media[]
  memos               Memo[]
  comments            Comment[]
  reactions           Reaction[]
  albums              Album[]
  createdLifeEvents   LifeEvent[]          @relation("LifeEventCreator")
  editedLifeEvents    LifeEvent[]          @relation("LifeEventLastEditor")
  editHistories       EditHistory[]
  createdSpecialDates SpecialDate[]        @relation("SpecialDateCreator")
  ownedSpecialDates   SpecialDate[]        @relation("SpecialDateOwner")
  notifications       Notification[]
  videoJobs           VideoJob[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  receivedInvitations Invitation[]         @relation("InvitationInvitee")
  plans               Plan[]
  planShares          PlanShare[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0) // 6-digit codes need a guess cap (added 2026-08-18)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─── Family & tree ──────────────────────────────────────────────────────────

model Family {
  id          String   @id @default(uuid())
  name        String
  inviteCode  String   @unique
  createdById String
  /// Ảnh đại diện của gia đình — ảnh cả nhà, hiện ở đầu màn cây gia phả.
  /// Cùng kiểu với Album.coverMediaId: SetNull để xoá ảnh không xoá gia đình.
  coverMediaId String?
  /// "Hanoi, Vietnam" — dòng phụ dưới tên nhà trên màn Omoide (mockup 13a);
  /// chữ tự do, không phải toạ độ.
  address String?
  /// Đôi câu cả nhà tự giới thiệu ("Four generations in the same lane…"),
  /// ≤140 ký tự — DTO chặn (mockup 13b).
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverMedia    Media?         @relation("FamilyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("FamilyCreator", fields: [createdById], references: [id])
  members       FamilyMember[]
  relationships Relationship[]
  postShares    PostFamily[]
  specialDates  SpecialDate[]
  invitations   Invitation[]
}

model FamilyMember {
  id          String   @id @default(uuid())
  familyId    String
  userId      String? // null = placeholder (no account)
  displayName String
  gender      Gender?
  avatarKey   String?
  joinedAt    DateTime @default(now())

  family             Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  placeholderProfile LifeProfile?         @relation("PlaceholderProfile")
  relationsFrom      Relationship[]       @relation("RelationFrom")
  relationsTo        Relationship[]       @relation("RelationTo")
  postTags           PostMemberTag[]
  lifeEventTags      LifeEventMemberTag[]
  specialDateTags    SpecialDateMember[]
  memosAbout         Memo[]
  plansFor           Plan[]
  invitations        Invitation[]
  interestSignals    InterestSignal[]
  profiles           MemberProfile[]
  counter            MemberCounter?

  @@unique([familyId, userId])
}

model LifeProfile {
  id          String    @id @default(uuid())
  userId      String?   @unique // global profile — XOR with memberId (CHECK in migration)
  memberId    String?   @unique // placeholder profile
  bio         String?
  interests   Json?
  birthDate   DateTime? @db.Date
  birthPlace  String? // free text — mockup 7 prints it after the birth date
  occupation  String? // free text ("Carpenter, retired since 2021"), not a job title
  deathDate   DateTime? @db.Date
  updatedById String? // last editor (wiki edit tracking)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User?         @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)
  member     FamilyMember? @relation("PlaceholderProfile", fields: [memberId], references: [id], onDelete: Cascade)
  updatedBy  User?         @relation("ProfileLastEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  lifeEvents LifeEvent[]
}

model Relationship {
  id           String           @id @default(uuid())
  familyId     String
  fromMemberId String // PARENT: from is a parent of to
  toMemberId   String
  type         RelationshipType
  label        String? // free text when type = OTHER
  createdAt    DateTime         @default(now())

  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromMember FamilyMember @relation("RelationFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("RelationTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([familyId, fromMemberId, toMemberId, type])
}

// Per-spot invite (Important Decisions 2026-08-18): a specific person is
// invited to a specific reserved tree node. `code` is what the link
// carries — Family.inviteCode stays as the open "anyone with the link"
// path and cannot mark a spot Pending.
model Invitation {
  id               String            @id @default(uuid())
  familyId         String
  memberId         String // the reserved spot — a placeholder FamilyMember
  inviterId        String
  inviteeUserId    String? // set when invited by email; null = code shared by hand
  code             String            @unique
  name             String // what the inviter calls the invitee
  relationshipType RelationshipType
  kinshipKey       String? // picker word ("sister") — display-only, client translates
  status           InvitationStatus  @default(PENDING)
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  family  Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member  FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  inviter User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User?        @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([inviteeUserId, status])
}

// ─── Content ────────────────────────────────────────────────────────────────

model Post {
  id           String    @id @default(uuid())
  authorUserId String
  type         PostType
  content      String?
  eventDate    DateTime? // type = EVENT
  eventTitle   String? // type = EVENT
  place        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author     User            @relation(fields: [authorUserId], references: [id])
  families   PostFamily[] // no rows = private to the author
  memberTags PostMemberTag[]
  media      Media[]
  comments   Comment[]
  reactions  Reaction[]
}

model PostFamily {
  postId   String
  familyId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([postId, familyId])
}

model PostMemberTag {
  postId   String
  memberId String

  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([postId, memberId])
}

model Media {
  id             String   @id @default(uuid())
  uploaderUserId String
  postId         String? // one-parent rule: at most one parent set (CHECK in migration)
  memoId         String?
  lifeEventId    String?
  storageKey     String // key in the storage backend — never a hard-coded URL
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  uploader  User       @relation(fields: [uploaderUserId], references: [id])
  post      Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  memo      Memo?      @relation(fields: [memoId], references: [id], onDelete: Cascade)
  lifeEvent LifeEvent? @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)

  @@index([memoId])
  @@index([lifeEventId])

  albumItems AlbumItem[]
  coverOf    Album[]       @relation("AlbumCover")
  coverOfFamily Family[]   @relation("FamilyCover")
  insight    MediaInsight?
  resultOf   VideoJob?     @relation("VideoJobResult")

  @@index([postId])
}

// The hidden store (decided 2026-08-19, docs/03-ai/architecture.md):
// vision-extracted facts about a photo, written only through the internal
// AI ingest endpoint and never exposed by any user-facing API. It exists
// solely to be folded back into suggestion context — filtered at use time
// by the requester's own visibility of the source media, so an insight can
// never leak content its photo would not have.
model MediaInsight {
  id        String   @id @default(uuid())
  mediaId   String   @unique // one insight per photo; re-analysis overwrites
  insight   Json // labels/scene/activities — shape owned by the AI team
  model     String // which model produced it, so a model change can re-run
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: deleting a photo withdraws its traces — the hidden store must
  // not remember what the user removed.
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  authorUserId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id])

  @@index([postId])
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId]) // one reaction per user per post
}

// ─── Personal: memos, albums ────────────────────────────────────────────────

model Memo {
  id            String   @id @default(uuid())
  ownerUserId   String // author — only they view/edit
  aboutMemberId String? // who the note is about; null = that member left/was removed
  aboutName     String // name snapshot at write time — the note stays readable after the member is gone (decided 2026-08-19)
  title         String // the bold card line (UI-led, 2026-08-19)
  content       String? // the longer body under it — optional since title arrived
  category      String? // client taxonomy (hobbies/health/gift/memories/todo) — free text like LifeEvent.type
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: a memo is the author's private notebook — another
  // person deleting a member (or leaving) must not burn it.
  aboutMember FamilyMember? @relation(fields: [aboutMemberId], references: [id], onDelete: SetNull)
  media       Media[]

  @@index([ownerUserId, aboutMemberId])
}

model Album {
  id           String   @id @default(uuid())
  ownerUserId  String // private — owner only
  name         String
  description  String?
  coverMediaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  coverMedia Media?      @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  items      AlbumItem[]
}

model AlbumItem {
  albumId String
  mediaId String
  addedAt DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
}

// ─── Life timeline ──────────────────────────────────────────────────────────

model LifeEvent {
  id          String   @id @default(uuid())
  profileId   String
  title       String
  description String?
  eventDate   DateTime @db.Date
  place       String?
  type        String? // taxonomy TBD when milestone timeline UI is designed
  createdById String
  updatedById String? // last editor (wiki edit tracking)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile    LifeProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation("LifeEventCreator", fields: [createdById], references: [id])
  updatedBy  User?                @relation("LifeEventLastEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  memberTags LifeEventMemberTag[]
  media      Media[]

  @@index([profileId, eventDate])
}

model LifeEventMemberTag {
  lifeEventId String
  memberId    String

  lifeEvent LifeEvent    @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([lifeEventId, memberId])
}

model EditHistory {
  id           String         @id @default(uuid())
  entityType   EditEntityType
  entityId     String // polymorphic — validated in the service layer
  editorUserId String
  snapshot     Json // entity content after the edit
  createdAt    DateTime       @default(now())

  editor User @relation(fields: [editorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
}

// ─── Special dates, notifications ───────────────────────────────────────────

model SpecialDate {
  id       String  @id @default(uuid())
  /// Phạm vi: đúng MỘT trong familyId / ownerUserId (XOR CHECK trong
  /// migration — Prisma không biểu diễn được, cùng kiểu LifeProfile).
  /// familyId = cả nhà thấy; ownerUserId = "Only me" (mockup 12c).
  familyId String?
  ownerUserId String?
  type        SpecialDateType
  title       String
  /// month/day theo lịch của isLunar: dương 1-12/1-31, ÂM 1-12/1-30.
  month Int
  day   Int
  /// true ⇒ ngày ÂM lịch VN (tz +7): ngày dương trôi theo năm, tháng nhuận
  /// bỏ qua, ngày 30 thiếu kẹp lùi 29 (src/common/lunar.ts).
  isLunar Boolean @default(false)
  /// false ⇒ một lần — `year` bắt buộc (theo lịch của chính dòng: năm ÂM
  /// khi isLunar). Một-lần đã qua biến khỏi danh sách và không nhắc nữa.
  repeatsYearly Boolean @default(true)
  year          Int?
  originYear    Int? // for ordinals ("50th", "turns 63")
  /// Nhắc chuông trong app trước N ngày (cộng thêm đúng ngày); 0 = chỉ
  /// đúng ngày. ReminderService đọc theo từng dòng (mockup 12c "10 days").
  remindDaysBefore Int              @default(7)
  theme            SpecialDateTheme
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  family    Family?             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner     User?               @relation("SpecialDateOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy User                @relation("SpecialDateCreator", fields: [createdById], references: [id])
  members   SpecialDateMember[]

  @@index([familyId])
  @@index([ownerUserId])
}

model SpecialDateMember {
  specialDateId String
  memberId      String

  specialDate SpecialDate  @relation(fields: [specialDateId], references: [id], onDelete: Cascade)
  member      FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([specialDateId, memberId])
}

model Notification {
  id              String           @id @default(uuid())
  recipientUserId String
  type            NotificationType
  payload         Json // type-specific data (postId, memberId, date, …)
  readAt          DateTime? // null = unread
  createdAt       DateTime         @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
}

// ─── AI outputs ─────────────────────────────────────────────────────────────

model VideoJob {
  id               String         @id @default(uuid())
  requesterUserId  String
  familyId         String? // family nguồn media (authorization + share về timeline)
  aboutMemberId    String? // video nói về ai (màn 27 "the video is about her")
  title            String? // "おばあちゃんの一年" — set sau khi có storyboard
  status           VideoJobStatus @default(PENDING)
  mode             String         @default("ai") // 'ai' = Build the story | 'quick' = stitch in my order
  options          Json? // { targetSec, mood, aspect, style, musicId, storyRequest, locale }
  plan             Json? // storyboard đã duyệt/sửa ở màn 31 (title/subtitle/opening/closing/dedication/scenes/palette)
  progress         Int            @default(0) // 0-100 — màn 32 "Almost there · 80%"
  stage            String? // "opening" | "scene:5" | "closing" | "music" — checklist màn 32
  inputMediaIds    Json
  resultStorageKey String? // set when DONE — raw path of the rendered file (audit trail)
  durationS        Float? // thời lượng file kết quả
  // The registered result row — written in the same transaction that
  // creates it (review 2026-08-19: deriving it back from storageKey was
  // an unindexed, non-unique lookup that could resolve to someone
  // else's row). SetNull: deleting the media flips a DONE job's result
  // to null rather than failing loudly — acceptable, it was the
  // requester's own delete.
  resultMediaId    String?        @unique
  error            String? // set when FAILED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  requester   User   @relation(fields: [requesterUserId], references: [id])
  resultMedia Media? @relation("VideoJobResult", fields: [resultMediaId], references: [id], onDelete: SetNull)

  // Cả HAI index tồn tại trong DB, mỗi bên một migration tạo một cái
  // (20260819011108 tạo composite, 20260819090000 của main tạo single) —
  // schema phải khai đủ cả hai, thiếu một là `migrate diff` báo drift vĩnh viễn.
  @@index([requesterUserId])
  @@index([requesterUserId, createdAt])
}

model Plan {
  id            String    @id @default(uuid())
  ownerUserId   String // creator — only they edit/share
  aboutMemberId String?
  title         String
  content       Json // steps/details — AI draft, editable by the owner
  occasionDate  DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  aboutMember FamilyMember? @relation(fields: [aboutMemberId], references: [id], onDelete: SetNull)
  shares      PlanShare[]
}

model PlanShare {
  planId           String
  sharedWithUserId String
  sharedAt         DateTime @default(now())

  plan       Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sharedWith User @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@id([planId, sharedWithUserId])
}

/// Sản phẩm sàn đã tra cho một (từ khoá, dải giá, tuần) — 0 token, chỉ để khỏi
/// gọi lại Yahoo API. Không phải dữ liệu gia đình: khoá không chứa member nào.
model ProductCache {
  cacheKey  String   @id
  keyword   String
  products  Json
  createdAt DateTime @default(now())
}

/// Cả LƯỢT gợi ý đã sinh ra, khoá theo (người + dịp + version hồ sơ + ngân sách).
///
/// Tầng cache thứ hai bên trên ProductCache: mở lại đúng màn hình đó không tốn
/// token nào, và vì khoá chứa version hồ sơ nên có bằng chứng mới là tự miss.
/// Hết hạn theo ngày diễn ra dịp (qua dịp rồi thì gợi ý cũ vô nghĩa).
model AiSuggestionCache {
  cacheKey  String   @id
  memberId  String
  kind      String // gift | message
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId, kind])
}

/// BẰNG CHỨNG NGUYÊN TỬ về một người — append-only, không bao giờ sửa nội dung.
///
/// Đây là tầng dưới của cặp "signal → profile": mỗi bài đăng được phân tích sinh
/// ra 0-4 signal về CHÍNH TÁC GIẢ (bài đăng nói lên sở thích của người đăng, không
/// phải của người trong ảnh). Profile là bản chưng cất có thể dựng lại từ đây,
/// nên tầng này là nguồn sự thật và không bị ghi đè khi rollup.
model InterestSignal {
  id       String @id @default(uuid())
  memberId String

  /// photo | video_transcript | caption | memo | manual_chip | gift_feedback
  sourceType String
  /// id của bài đăng / memo / suggestion sinh ra signal này
  sourceId String?
  /// like | dislike | wish | habit | health | milestone | gift_idea
  signalType String
  /// cụm từ khoá ngắn, đã chuẩn hoá theo góc nhìn của người đăng
  topic  String
  detail String
  /// 0-1; suy từ ảnh trần 0.85, từ caption trần 0.75, feedback người dùng 0.9+
  confidence Float
  /// căn cứ model nêu ra ("caption", "ảnh 2", "transcript")
  basis Json?
  /// ngày SỰ VIỆC xảy ra (ngày chụp), không phải ngày ghi nhận
  observedAt DateTime @db.Date
  /// đã được gộp vào một version profile chưa
  processed Boolean @default(false)
  /// bài gốc bị xoá trước khi rollup → thu hồi, mọi chỗ đọc phải lọc revoked=false
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, processed, revoked])
}

/// Bản CHƯNG CẤT ~1k token của một người, version hoá.
///
/// Mỗi lần rollup là một version MỚI (không sửa version cũ) → xem lại được hồ sơ
/// tại thời điểm bất kỳ, và một gợi ý luôn truy được về đúng hồ sơ đã sinh ra nó.
model MemberProfile {
  memberId String
  version  Int
  /// { summary, interests[], avoid[], wishes[], giftIdeasPending[], giftHistory[], conversationTopics[], styleHints }
  profile   Json
  createdAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, version])
}

/// Đếm bài đăng của MỖI người kể từ lần rollup gần nhất — chạm ngưỡng thì gộp.
/// Đếm theo người, không theo gia đình: hồ sơ là của một người.
model MemberCounter {
  memberId         String   @id
  postsSinceRollup Int      @default(0)
  updatedAt        DateTime @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
