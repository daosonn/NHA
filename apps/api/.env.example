# Local development default — matches docker-compose Postgres (root .env.example).
# Copy to .env (done automatically by `pnpm bootstrap` at the repo root).
DATABASE_URL="postgresql://nha:nha_password@localhost:5432/nha?schema=public"

# Auth (JWT). Generate a long random JWT_ACCESS_SECRET per environment —
# never commit a real one.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Social login (WBS 1.1.8–1.1.9). Leave empty to disable a provider — its
# endpoints then return 503. Redirect URI to register with the provider:
#   <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/<google|facebook>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"

# Media uploads (WBS 1.5.3) — root folder of the local-disk storage backend
# used for the MVP demo. Relative paths resolve against apps/api.
UPLOAD_DIR="./uploads"
